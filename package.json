{
  "name": "lark-channel-bridge",
  "version": "0.7.1",
  "description": "Bridge Feishu/Lark messenger with local CLI coding agents",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KuribohG/lark-coding-agent-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/KuribohG/lark-coding-agent-bridge/issues"
  },
  "homepage": "https://github.com/KuribohG/lark-coding-agent-bridge#readme",
  "bin": {
    "lark-channel-bridge": "./bin/lark-channel-bridge.mjs",
    "run-lark-cc": "./bin/run-lark-cc.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./channels/lark": {
      "types": "./dist/lark.d.ts",
      "import": "./dist/lark.js"
    },
    "./channels/web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./channels/slack": {
      "types": "./dist/slack.d.ts",
      "import": "./dist/slack.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "README.zh.md",
    "docs/README.md",
    "docs/runtime-reference.md",
    "docs/windows-web-validation.md",
    "docs/inbox-assistant.md",
    "docs/gitlab-ci-watch.md",
    "docs/agent-execution.md",
    "docs/antigravity.md",
    "docs/model-services.md",
    "docs/work-item-sources.md",
    "docs/monitor-config.md",
    "docs/storage-monitoring.md",
    "docs/monitors.example.toml",
    "LICENSE",
    "docs/self-contained.md",
    "docs/user-guide",
    "docs/channels.md",
    "docs/configuration.md",
    "docs/config.example.toml",
    "docs/workflows.md",
    "workflow-definitions"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build:web": "vite build web",
    "build": "npm run build:web && tsup",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:web",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:process": "vitest run tests/process --passWithNoTests",
    "lint:dead": "knip --include files,exports",
    "ci:local": "git diff --check && npm run lint:dead && npm run test && npm run typecheck && npm run typecheck:web && npm run build",
    "ci:platform": "npm run lint:dead && npm run test && npm run typecheck && npm run typecheck:web && npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "test:codex-native-env": "vitest run tests/process/codex-native-environment.test.ts",
    "test:workflow-native": "node tests/acceptance/run-workflow-native.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@larksuite/channel": "^0.6.0",
    "@slack/socket-mode": "3.1.0",
    "@slack/web-api": "8.2.0",
    "axios": "1.20.0",
    "better-sqlite3": "12.11.1",
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.6",
    "graceful-fs": "^4.2.11",
    "jsonrepair": "3.15.0",
    "proper-lockfile": "^4.1.2",
    "proxy-agent": "^8.0.2",
    "qrcode-terminal": "^0.12.0",
    "quickjs-emscripten": "0.32.0",
    "smol-toml": "^1.8.0",
    "toml-eslint-parser": "0.10.0",
    "undici": "^7.0.0",
    "ws": "8.20.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/graceful-fs": "^4.1.9",
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "knip": "^5.88.1",
    "lucide-react": "^1.24.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "protobufjs",
      "@larksuite/cli"
    ]
  },
  "keywords": [
    "feishu",
    "lark",
    "claude",
    "claude-code",
    "codex",
    "cli",
    "channel",
    "bridge"
  ],
  "license": "MIT",
  "optionalDependencies": {
    "@larksuite/cli": "1.0.77"
  }
}
